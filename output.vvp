    %store/vec4 v0x12a71b070_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x12a71b110_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x12a71b070_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x12a71b110_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x12a71b070_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x12a71b110_0, 0, 1;
    %delay 10000, 0;
