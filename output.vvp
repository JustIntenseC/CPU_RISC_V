    %vpi_call 2 23 "$monitor", "\320\222\321\200\320\265\320\274\321\217 = %0t | a = %b | b = %b | \320\222\321\213\321\205\320\276\320\264 y = %b", $time, v0x12a71b070_0, v0x12a71b110_0, v0x12a71b1c0_0 {0 0 0};
